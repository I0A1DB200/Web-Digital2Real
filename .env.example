# Optional demo API only. Empty disables browser cross-origin requests.
# Comma-separated exact HTTP(S) origins, for example http://localhost:8000
D2R_DEMO_ALLOWED_ORIGINS=

# Optional local platform API. Use an existing directory outside the repository.
D2R_LOCAL_DB=
# Leave all three empty for anonymous mode. Use synthetic issuer and public keys only.
D2R_LOCAL_TOKEN_ISSUER=
D2R_LOCAL_TOKEN_AUDIENCE=
D2R_LOCAL_JWKS_FILE=
